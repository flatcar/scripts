ARG BASE

FROM ${BASE}
COPY --chown=sdk:sdk sdk_container/ /mnt/host/source
COPY --chown=sdk:sdk . /mnt/host/source/src/scripts

RUN chown sdk:sdk /mnt/host/source

# remove old portage-stable artefacts, only required when updating from pre-Gentoo overlay stack
RUN rm -f /etc/portage/repos.conf/portage-stable.conf /build/*/etc/portage/repos.conf/portage-stable.conf

# Before doing anything, reset / regenerate all configs
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./update_chroot --setuponly
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
          crossdev --ex-gdb --init-target x86_64-cros-linux-gnu \
      &&  crossdev --ex-gdb --init-target aarch64-cros-linux-gnu
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./setup_board --board="arm64-usr" --regen_configs_only
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./setup_board --board="amd64-usr" --regen_configs_only

# Now initialise the chroot and boards.
# This should rebuild all updated packages.
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./update_chroot --toolchain_boards="amd64-usr arm64-usr"

RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./setup_board --board="arm64-usr" --regen_configs
RUN FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox" \
      /home/sdk/sdk_entry.sh ./setup_board --board="amd64-usr" --regen_configs

# Clean up ephemeral key directory variables that were added during build
RUN sed -i -e '/export MODULE_SIGNING_KEY_DIR=/d' \
        -e '/export MODULES_SIGN_KEY=/d' \
        -e '/export MODULES_SIGN_CERT=/d' /home/sdk/.bashrc
