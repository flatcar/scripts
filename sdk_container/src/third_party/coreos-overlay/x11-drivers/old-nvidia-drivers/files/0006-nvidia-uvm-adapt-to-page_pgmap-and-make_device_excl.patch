From 0000000000000000000000000000000000000008 Mon Sep 17 00:00:00 2001
From: Sayan Chowdhury <sayan.chowdhury2012@gmail.com>
Date: Wed, 2 Sep 2026 00:00:00 +0530
Subject: [PATCH] nvidia-uvm: adapt to page_pgmap() and
 make_device_exclusive() for Linux 6.18

Two mm API changes broke the nvidia-uvm kernel-open build against
Linux 6.18.45:

1. struct page no longer has a 'pgmap' member. The pgmap pointer
   moved to struct folio (a pgmap is shared by every page in a
   folio), and is now accessed through the page_pgmap() helper.

2. make_device_exclusive_range(), which converted a whole address
   range and filled a caller-supplied page array, was replaced by
   make_device_exclusive(), which operates on a single address and
   also returns the containing folio. The call in
   hmm_block_atomic_fault_locked() is rewritten to loop over each
   page in the region, preserving the old function's
   partial-success semantics (stop at the first failure; the
   existing downstream loop already tolerates NULL page entries).

Both changes are guarded with conftest probes (NV_PAGE_PGMAP_PRESENT,
NV_MAKE_DEVICE_EXCLUSIVE_PRESENT) rather than a hardcoded
LINUX_VERSION_CODE check, since this detects the feature directly
against the actual kernel headers and remains correct for backports
or non-standard kernel versioning.

Only applied to the kernel-open tree; this was verified with a
kernel-open build against Linux 6.18.45. The proprietary kernel/
tree likely needs the same treatment but has not been built or
verified here.

Signed-off-by: Sayan Chowdhury <sayan.chowdhury2012@gmail.com>
---
diff --git a/kernel-module-source/kernel-open/conftest.sh b/kernel-module-source/kernel-open/conftest.sh
index 30506f8f..1a2b3c4d 100755
--- a/kernel-module-source/kernel-open/conftest.sh
+++ b/kernel-module-source/kernel-open/conftest.sh
@@ -7148,6 +7148,42 @@
             compile_check_conftest "$CODE" "NV_FOLIO_TEST_SWAPCACHE_PRESENT" "" "functions"
         ;;
 
+    page_pgmap)
+            #
+            # Determine if the page_pgmap() function is present.
+            #
+            # The mm subsystem moved the pgmap pointer from struct page to
+            # struct folio (a pgmap is shared by every page in a folio), so
+            # direct page->pgmap access was replaced with page_pgmap().
+            #
+            CODE="
+            #include <linux/mm.h>
+            #include <linux/mmzone.h>
+            void conftest_page_pgmap(void) {
+                page_pgmap();
+            }"
+
+            compile_check_conftest "$CODE" "NV_PAGE_PGMAP_PRESENT" "" "functions"
+        ;;
+
+    make_device_exclusive)
+            #
+            # Determine if the make_device_exclusive() function is present.
+            #
+            # make_device_exclusive_range(), which converted a whole address
+            # range and filled a caller-supplied page array, was replaced by
+            # make_device_exclusive(), which operates on a single address and
+            # also returns the containing folio.
+            #
+            CODE="
+            #include <linux/rmap.h>
+            void conftest_make_device_exclusive(void) {
+                make_device_exclusive();
+            }"
+
+            compile_check_conftest "$CODE" "NV_MAKE_DEVICE_EXCLUSIVE_PRESENT" "" "functions"
+        ;;
+
 
         drm_driver_has_date)
             #
diff --git a/kernel-module-source/kernel-open/nvidia-uvm/nvidia-uvm.Kbuild b/kernel-module-source/kernel-open/nvidia-uvm/nvidia-uvm.Kbuild
index 4ccaf27b..5a1a34af 100644
--- a/kernel-module-source/kernel-open/nvidia-uvm/nvidia-uvm.Kbuild
+++ b/kernel-module-source/kernel-open/nvidia-uvm/nvidia-uvm.Kbuild
@@ -70,6 +70,8 @@
 NV_CONFTEST_FUNCTION_COMPILE_TESTS += find_next_bit_wrap
 NV_CONFTEST_FUNCTION_COMPILE_TESTS += iommu_is_dma_domain
 NV_CONFTEST_FUNCTION_COMPILE_TESTS += folio_test_swapcache
+NV_CONFTEST_FUNCTION_COMPILE_TESTS += page_pgmap
+NV_CONFTEST_FUNCTION_COMPILE_TESTS += make_device_exclusive
 
 NV_CONFTEST_TYPE_COMPILE_TESTS += backing_dev_info
 NV_CONFTEST_TYPE_COMPILE_TESTS += mm_context_t
diff --git a/kernel-module-source/kernel-open/nvidia-uvm/uvm_pmm_gpu.c b/kernel-module-source/kernel-open/nvidia-uvm/uvm_pmm_gpu.c
index 1c842015..973c2c64 100644
--- a/kernel-module-source/kernel-open/nvidia-uvm/uvm_pmm_gpu.c
+++ b/kernel-module-source/kernel-open/nvidia-uvm/uvm_pmm_gpu.c
@@ -3309,7 +3309,11 @@
 
 static uvm_pmm_gpu_t *devmem_page_to_pmm(struct page *page)
 {
+#if defined(NV_PAGE_PGMAP_PRESENT)
+    return container_of(page_pgmap(page), uvm_pmm_gpu_t, devmem.pagemap);
+#else
     return container_of(page->pgmap, uvm_pmm_gpu_t, devmem.pagemap);
+#endif
 }
 
 static uvm_gpu_chunk_t *devmem_page_to_chunk_locked(struct page *page)
diff --git a/kernel-module-source/kernel-open/nvidia-uvm/uvm_hmm.c b/kernel-module-source/kernel-open/nvidia-uvm/uvm_hmm.c
index da2b7010..12fe50ef 100644
--- a/kernel-module-source/kernel-open/nvidia-uvm/uvm_hmm.c
+++ b/kernel-module-source/kernel-open/nvidia-uvm/uvm_hmm.c
@@ -51,6 +51,7 @@
 
 #include <linux/hmm.h>
 #include <linux/rmap.h>
+#include <linux/err.h>
 #include <linux/migrate.h>
 #include <linux/userfaultfd_k.h>
 #include <linux/memremap.h>
@@ -1986,7 +1987,11 @@
 
     dpage = pfn_to_page(pfn);
     UVM_ASSERT(is_device_private_page(dpage));
+#if defined(NV_PAGE_PGMAP_PRESENT)
+    UVM_ASSERT(page_pgmap(dpage)->owner == &g_uvm_global);
+#else
     UVM_ASSERT(dpage->pgmap->owner == &g_uvm_global);
+#endif
 
     hmm_mark_gpu_chunk_referenced(va_block, gpu, gpu_chunk);
     UVM_ASSERT(!page_count(dpage));
@@ -2481,11 +2486,38 @@
 
     uvm_mutex_unlock(&va_block->lock);
 
+#if defined(NV_MAKE_DEVICE_EXCLUSIVE_PRESENT)
+    // make_device_exclusive_range() was replaced by the single-address
+    // make_device_exclusive(), which also returns the containing folio.
+    // Emulate the old range API by looping over each page in the region:
+    // npages counts how many leading pages in the region succeeded, and we
+    // stop at the first failure, matching the old function's partial-success
+    // semantics (the caller below fills any remaining pages with NULL).
+    npages = 0;
+    for_each_va_block_page_in_region(page_index, region) {
+        struct page *page;
+        struct folio *folio;
+
+        page = make_device_exclusive(service_context->block_context->mm,
+                                      uvm_va_block_cpu_page_address(va_block, page_index),
+                                      &g_uvm_global,
+                                      &folio);
+        if (IS_ERR(page)) {
+            if (npages == 0)
+                npages = PTR_ERR(page);
+            break;
+        }
+
+        pages[page_index] = page;
+        npages++;
+    }
+#else
     npages = make_device_exclusive_range(service_context->block_context->mm,
         uvm_va_block_cpu_page_address(va_block, region.first),
         uvm_va_block_cpu_page_address(va_block, region.outer - 1) + PAGE_SIZE,
         pages + region.first,
         &g_uvm_global);
+#endif
 
     uvm_mutex_lock(&va_block->lock);
 
--
2.53.0
