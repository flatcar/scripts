From 691dfae5bebac72a36b99e6cbfca5a5f43741d64 Mon Sep 17 00:00:00 2001
From: James Le Cuirot <jlecuirot@microsoft.com>
Date: Mon, 6 Apr 2026 13:13:58 +0100
Subject: [PATCH 14/15] config: Support oem:// schema in newer config spec
 versions

Signed-off-by: James Le Cuirot <jlecuirot@microsoft.com>
Signed-off-by: Mathieu Tortuyaux <mtortuyaux@microsoft.com>
---
 config/v3_5/types/url.go              | 2 +-
 config/v3_6/types/url.go              | 2 +-
 config/v3_7_experimental/types/url.go | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/config/v3_5/types/url.go b/config/v3_5/types/url.go
index 97a4c9ae..7bcad990 100644
--- a/config/v3_5/types/url.go
+++ b/config/v3_5/types/url.go
@@ -32,7 +32,7 @@ func validateURL(s string) error {
 	}
 
 	switch u.Scheme {
-	case "http", "https", "tftp", "gs":
+	case "http", "https", "tftp", "gs", "oem":
 		return nil
 	case "s3":
 		if v, ok := u.Query()["versionId"]; ok {
diff --git a/config/v3_6/types/url.go b/config/v3_6/types/url.go
index 97a4c9ae..7bcad990 100644
--- a/config/v3_6/types/url.go
+++ b/config/v3_6/types/url.go
@@ -32,7 +32,7 @@ func validateURL(s string) error {
 	}
 
 	switch u.Scheme {
-	case "http", "https", "tftp", "gs":
+	case "http", "https", "tftp", "gs", "oem":
 		return nil
 	case "s3":
 		if v, ok := u.Query()["versionId"]; ok {
diff --git a/config/v3_7_experimental/types/url.go b/config/v3_7_experimental/types/url.go
index 97a4c9ae..7bcad990 100644
--- a/config/v3_7_experimental/types/url.go
+++ b/config/v3_7_experimental/types/url.go
@@ -32,7 +32,7 @@ func validateURL(s string) error {
 	}
 
 	switch u.Scheme {
-	case "http", "https", "tftp", "gs":
+	case "http", "https", "tftp", "gs", "oem":
 		return nil
 	case "s3":
 		if v, ok := u.Query()["versionId"]; ok {
