From d8a5efaf9354a4440c2b596275831685d558d3ae Mon Sep 17 00:00:00 2001
From: James Le Cuirot <chewi@gentoo.org>
Date: Tue, 22 Sep 2026 11:24:12 +0100
Subject: [PATCH 1/3] porttree: ensure getRepositories is consistent after
 changing porttrees

Signed-off-by: James Le Cuirot <chewi@gentoo.org>
---
 lib/portage/dbapi/porttree.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/lib/portage/dbapi/porttree.py b/lib/portage/dbapi/porttree.py
index 2d791d35b..54ed08b8e 100644
--- a/lib/portage/dbapi/porttree.py
+++ b/lib/portage/dbapi/porttree.py
@@ -222,9 +222,6 @@ class portdbapi(dbapi):
         self.xcache = {}
         self.frozen = 0
 
-        # Keep a list of repo names, sorted by priority (highest priority first).
-        self._ordered_repo_name_list = tuple(reversed(self.repositories.prepos_order))
-
         self.auxdbmodule = self.settings.load_best_module("portdbapi.auxdbmodule")
         self.auxdb = {}
         self._pregen_auxdb = {}
@@ -345,6 +342,9 @@ class portdbapi(dbapi):
             )
         )
 
+        # Keep a list of repo names, sorted by priority (highest priority first).
+        self._ordered_repo_name_list = tuple(reversed(self._porttrees_repos))
+
     def _get_porttrees(self):
         return self._porttrees
 
