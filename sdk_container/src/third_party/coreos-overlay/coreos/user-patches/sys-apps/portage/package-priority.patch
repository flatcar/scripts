From 85694efe939f4fe66950f61034cba979ee290128 Mon Sep 17 00:00:00 2001
From: James Le Cuirot <chewi@gentoo.org>
Date: Thu, 24 Sep 2026 18:49:33 +0100
Subject: [PATCH 3/3] config: repos.conf: Rename priority to version-priority

This avoids confusion with the new package-priority. The old priority
name is kept as an alias for compatibility.

Bug: https://bugs.gentoo.org/983159
Signed-off-by: James Le Cuirot <chewi@gentoo.org>
---
 NEWS                                          |  4 +++
 lib/_emerge/Package.py                        |  4 +--
 lib/_emerge/depgraph.py                       |  6 ++--
 lib/portage/dbapi/porttree.py                 | 12 +++----
 lib/portage/repository/config.py              | 34 +++++++++++--------
 .../resolver/test_binpackage_selection.py     |  8 ++---
 lib/portage/tests/resolver/test_multirepo.py  |  2 +-
 man/portage.5                                 |  4 +--
 8 files changed, 41 insertions(+), 33 deletions(-)

diff --git a/lib/_emerge/Package.py b/lib/_emerge/Package.py
index a41d3e0c4..b861955a4 100644
--- a/lib/_emerge/Package.py
+++ b/lib/_emerge/Package.py
@@ -712,11 +712,11 @@ class Package(Task):
         return self._metadata["repository"]
 
     @property
-    def repo_priority(self):
+    def repo_version_priority(self):
         repo_info = self.root_config.settings.repositories.prepos.get(self.repo)
         if repo_info is None:
             return None
-        return repo_info.priority
+        return repo_info.version_priority
 
     @property
     def use(self):
diff --git a/lib/_emerge/depgraph.py b/lib/_emerge/depgraph.py
index 8698cdaf8..e45c3251a 100644
--- a/lib/_emerge/depgraph.py
+++ b/lib/_emerge/depgraph.py
@@ -8012,7 +8012,7 @@ class depgraph:
                         # list only contains unbuilt ebuilds since USE can't
                         # be changed for built packages.
                         higher_version_rejected = False
-                        repo_priority = pkg.repo_priority
+                        repo_priority = pkg.repo_version_priority
                         for rejected in packages_with_invalid_use_config:
                             if rejected.cp != pkg.cp:
                                 continue
@@ -8021,8 +8021,8 @@ class depgraph:
                                 break
                             if portage.dep.cpvequal(rejected.cpv, pkg.cpv):
                                 # If version is identical then compare
-                                # repo priority (see bug #350254).
-                                rej_repo_priority = rejected.repo_priority
+                                # repo version-priority (see bug #350254).
+                                rej_repo_priority = rejected.repo_version_priority
                                 if rej_repo_priority is not None and (
                                     repo_priority is None
                                     or rej_repo_priority > repo_priority
diff --git a/lib/portage/dbapi/porttree.py b/lib/portage/dbapi/porttree.py
